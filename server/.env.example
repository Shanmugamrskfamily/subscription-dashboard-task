# Copy to server/.env (git-ignored) and fill in. `npm run gen:keys` fills the secrets for you.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MongoDB Atlas connection string with the database name, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/planpilot?retryWrites=true&w=majority
# Leave empty in development to use a temporary in-memory database.
MONGODB_URI=
# Only if your network's DNS refuses SRV lookups (querySrv ECONNREFUSED): 8.8.8.8,1.1.1.1
DNS_SERVERS=

# Access tokens (filled by npm run gen:keys; at least 32 characters in production)
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Encrypted API payloads: ECDH P-256 key pair (filled by npm run gen:keys).
# The public key also goes to the client as VITE_PAYLOAD_PUBLIC_KEY.
PAYLOAD_PRIVATE_KEY=
PAYLOAD_PUBLIC_KEY=
PAYLOAD_KID=k1
# Defaults to true in production: refuse requests that aren't encrypted.
ENCRYPTION_REQUIRED=

# Payments: "razorpay" (test mode keys) or "simulated" (built-in test checkout).
# Defaults to razorpay when both keys are set, otherwise simulated.
PAYMENTS_MODE=
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Comma-separated origins allowed to call the API (the Vite dev server, the Vercel site)
CLIENT_ORIGINS=http://localhost:5173
# Number of proxies in front of the API (Render: 1; Render behind the Vercel rewrite: 2)
TRUST_PROXY=0
# Seed the four plans and the demo database on start-up if they're missing
SEED_ON_BOOT=true
# Allow the admin "Reset demo data" button
DEMO_MODE=true
SUPPORT_EMAIL=support@planpilot.demo
