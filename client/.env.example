# Copy to client/.env.local (git-ignored). On Vercel, set these in Project Settings → Environment Variables.
# Public values only: everything with the VITE_ prefix ends up in the browser bundle.

# Absolute site URL, used in the link-preview (Open Graph) tags and the canonical link.
VITE_SITE_URL=http://localhost:5173

# The server's PUBLIC key for encrypted API traffic (npm run gen:keys writes both).
VITE_PAYLOAD_PUBLIC_KEY=
VITE_PAYLOAD_KID=k1
